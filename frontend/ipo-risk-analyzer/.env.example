# IPO Risk Analyzer — 环境变量模板
# 复制到本目录：cp .env.example .env
# Vite 从【前端包根目录】读取（vite.config.ts → envDir），不是 client/ 目录
# 在 IPOI 仓库中路径为：frontend/ipo-risk-analyzer/

# 统一 API 网关（解析 / 检索 / 分析均走同一 Base URL，需含 /api/v1 前缀）
# VITE_API_BASE_URL=http://localhost:9100/api/v1
# VITE_API_BASE_URL=http://223.3.95.129:9100/api/v1

VITE_API_BASE_URL=http://localhost:9100/api/v1
